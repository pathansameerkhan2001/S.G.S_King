# ---------------------------------------------------------------------------
# S.G.S King Foods — environment variables
# Copy to .env.local (local dev) or set in your hosting provider.
# NEVER commit real secrets. NEVER prefix server values with NEXT_PUBLIC_.
# Values below marked (verified) were read from your AWS account; they are
# identifiers, not secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for canonical links, sitemap, share links)
NEXT_PUBLIC_SITE_URL=https://www.sgskingfoods.com

# ----- Admin authentication (AWS Cognito, server-only) ----------------------
COGNITO_REGION=us-east-1                                  # (verified)
COGNITO_USER_POOL_ID=us-east-1_I83AzzfjR                  # (verified)
COGNITO_CLIENT_ID=5siadavgn0llmbih71jli91pf9              # (verified) app client "sgs-king-admin-web"
# Managed login domain (verified prefix "us-east-1i83azzfjr"); no trailing slash
COGNITO_DOMAIN=https://us-east-1i83azzfjr.auth.us-east-1.amazoncognito.com
# Leave empty: this app client has NO client secret (public client + PKCE)
COGNITO_CLIENT_SECRET=
COGNITO_ADMIN_GROUP=ADMIN                                 # (verified)
# Origin of THIS deployment; the callback is ${APP_BASE_URL}/admin/auth/callback
# and must be listed under the app client's "Allowed callback URLs".
APP_BASE_URL=http://localhost:3000
# Optional: enables full Cognito sign-out. Must be listed under the app
# client's "Allowed sign-out URLs" (currently NONE are configured).
COGNITO_LOGOUT_REDIRECT_URI=
# Random secret (≥ 32 chars) used to encrypt the admin session cookie.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ----- AWS data (server-only) -----------------------------------------------
AWS_REGION=us-east-1                                      # (verified) tables + bucket region
S3_ASSETS_BUCKET=sgs-king-foods-assets                    # (verified) private bucket
DDB_PRODUCTS_TABLE=SGSKingProducts
DDB_CATEGORIES_TABLE=SGSKingCategories
DDB_COMBOS_TABLE=SGSKingCombos
DDB_ORDERS_TABLE=SGSKingOrders
MEDIA_MAX_UPLOAD_MB=5

# AWS credentials: prefer an IAM role on your host. For local development use
# your AWS CLI profile (AWS_PROFILE) or, if you must, an access key pair for a
# least-privilege IAM user (see docs/admin-setup.md). Never commit these.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
